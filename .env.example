# Dashboard (Vercel env vars - never commit real values)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable/anon key>   # public key; useless without DASH_DB_TOKEN
DASH_DB_TOKEN=<gateway token checked inside the DB RPC functions>
DASHBOARD_PASSWORD=<shared password for Eyal>
SESSION_SECRET=<random 32+ bytes hex, signs the login cookie>
BOT_TOKEN=<bearer token for /api/bot-update and /api/export>
# Only for scripts/shopify-snapshot.mjs (run on the box, NOT needed on Vercel)
SHOPIFY_CLIENT_SECRET=
DASHBOARD_URL=https://<your-deployment>
